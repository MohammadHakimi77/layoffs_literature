# 5c) PSM
psm_covs <- intersect(covariates_psm_full, names(unit_df))
psm_covs <- psm_covs[
sapply(unit_df[psm_covs], function(x) {
x2 <- x[!is.na(x)]
length(x2) > 1L && sd(x2) > 0
})
]
n_psm_matched_don <- 0L
best_caliper      <- NA_real_
best_mean_smd     <- Inf
best_prop_treated <- NA_real_
best_match_obj    <- NULL
psm_matched_ids   <- integer(0)
if (length(psm_covs) > 0L) {
psm_input <- unit_df %>%
select(steam_id, treated_in_cohort, all_of(psm_covs)) %>%
drop_na()
if (nrow(psm_input) > 0L &&
sum(psm_input$treated_in_cohort == 1L) > 0L &&
sum(psm_input$treated_in_cohort == 0L) > 0L) {
form_psm <- as.formula(
paste("treated_in_cohort ~", paste(psm_covs, collapse = " + "))
)
for (cal in caliper_grid) {
m_try <- try(
matchit(
formula  = form_psm,
data     = psm_input,
method   = "nearest",
distance = "logit",
ratio    = 1,
replace  = TRUE,
caliper  = cal
),
silent = TRUE
)
if (inherits(m_try, "try-error")) next
s <- summary(m_try, standardize = TRUE)
smd_matched   <- s$sum.matched[, "Std. Mean Diff."]
mean_abs_smd  <- mean(abs(smd_matched), na.rm = TRUE)
md <- match.data(m_try)
n_treated_total   <- sum(psm_input$treated_in_cohort == 1L)
n_treated_matched <- length(unique(md$steam_id[md$treated_in_cohort == 1L]))
prop_treated      <- n_treated_matched / n_treated_total
if (prop_treated < 0.7) next
if (mean_abs_smd < best_mean_smd) {
best_mean_smd     <- mean_abs_smd
best_caliper      <- cal
best_prop_treated <- prop_treated
best_match_obj    <- m_try
}
}
if (!is.null(best_match_obj)) {
md_best <- match.data(best_match_obj)
psm_matched_ids <- unique(md_best$steam_id[md_best$treated_in_cohort == 0L])
n_psm_matched_don <- length(psm_matched_ids)
cat("Best PSM caliper =", best_caliper,
"| mean |SMD| =", round(best_mean_smd, 3),
"| prop treated matched =", round(best_prop_treated, 3), "\n")
} else {
cat("No acceptable PSM solution (calipers too strict or separation).\n")
}
} else {
cat("PSM input too small or unbalanced; skipping PSM.\n")
}
} else {
cat("No PSM covariates available in this cohort.\n")
}
# 5d) Save cohort-level summary + unit-level flags
matching_summary_list[[kk]] <- tibble(
g                  = c_g,
T0_c               = c_T0,
n_treated          = n_treated,
n_donors           = n_donors,
n_cem_matched_don  = n_cem_matched_don,
n_psm_matched_don  = n_psm_matched_don,
cem_mean_smd_before = cem_mean_smd_before,
cem_mean_smd_after  = cem_mean_smd_after,
psm_best_caliper    = best_caliper,
psm_mean_abs_smd    = ifelse(is.finite(best_mean_smd), best_mean_smd, NA_real_),
psm_prop_treated    = best_prop_treated
)
flags_df <- unit_df %>%
mutate(
cem_donor_matched = if_else(
treated_in_cohort == 0L & steam_id %in% cem_matched_ids,
1L, 0L
),
psm_donor_matched = if_else(
treated_in_cohort == 0L &
!is.null(best_match_obj) &
steam_id %in% psm_matched_ids,
1L, 0L
),
g    = c_g,
T0_c = c_T0
)
matched_flags_list[[kk]] <- flags_df
}
matching_summary_by_cohort <- bind_rows(matching_summary_list)
matched_units_all          <- bind_rows(matched_flags_list)
cat("\nFinal matching summary by cohort:\n")
print(matching_summary_by_cohort)
write_csv(matching_summary_by_cohort,
file.path(out_dir_match, "matching_summary_by_cohort.csv"))
write_csv(matched_units_all,
file.path(out_dir_match, "matched_units_all_flags.csv"))
# This is what ASCM will use to filter donors:
matched_flags_full <- matched_units_all %>%
select(steam_id, g, cem_donor_matched, psm_donor_matched)
################################################
# 6. (Optional) LOVE PLOT for one PSM cohort
################################################
example_g <- 120  # change if you like
example_row <- matching_summary_by_cohort %>%
filter(g == example_g)
if (nrow(example_row) == 1L) {
idx_ex <- which(cohort_ids == example_g)
if (length(idx_ex) == 1L) {
example_sub <- cohort_dataL[[idx_ex]]
all_covs_for_matching_ex <- intersect(
unique(c(covariates_psm_full, covariates_cem_full)),
names(example_sub)
)
example_unit_df <- example_sub %>%
filter(cohort_unit | donor_ok) %>%
group_by(steam_id) %>%
summarise(
treated_in_cohort = as.integer(any(cohort_unit)),
donor_candidate   = as.integer(any(donor_ok & !cohort_unit)),
across(all_of(all_covs_for_matching_ex), first_non_na),
.groups = "drop"
) %>%
filter(treated_in_cohort == 1L | donor_candidate == 1L)
psm_covs_ex <- intersect(covariates_psm_full, names(example_unit_df))
psm_covs_ex <- psm_covs_ex[
sapply(example_unit_df[psm_covs_ex], function(x) {
x2 <- x[!is.na(x)]
length(x2) > 1L && sd(x2) > 0
})
]
if (length(psm_covs_ex) > 0L) {
psm_input_ex <- example_unit_df %>%
select(steam_id, treated_in_cohort, all_of(psm_covs_ex)) %>%
drop_na()
if (nrow(psm_input_ex) > 0L &&
any(psm_input_ex$treated_in_cohort == 1L) &&
any(psm_input_ex$treated_in_cohort == 0L)) {
form_psm_ex <- as.formula(
paste("treated_in_cohort ~", paste(psm_covs_ex, collapse = " + "))
)
cal_ex <- example_row$psm_best_caliper
if (is.na(cal_ex) || cal_ex <= 0) cal_ex <- 0.2
try_match <- function(caliper_value) {
try(
matchit(
formula  = form_psm_ex,
data     = psm_input_ex,
method   = "nearest",
distance = "logit",
ratio    = 1,
replace  = TRUE,
caliper  = caliper_value
),
silent = TRUE
)
}
m_ex_try <- try_match(cal_ex)
if (inherits(m_ex_try, "try-error")) {
cat("\n[LOVE PLOT] matchit failed for cohort g =", example_g,
"with caliper", cal_ex, "— retrying with no caliper.\n")
m_ex_try <- try_match(NULL)
}
if (!inherits(m_ex_try, "try-error")) {
m_ex <- m_ex_try
w_ex <- m_ex$weights
t_ex <- m_ex$treat
if (any(w_ex > 0 & t_ex == 0)) {
s_ex <- summary(m_ex, standardize = TRUE)
bal_all_ex     <- as.data.frame(s_ex$sum.all)
bal_matched_ex <- as.data.frame(s_ex$sum.matched)
balance_tbl <- tibble(
covariate   = rownames(bal_all_ex),
smd_all     = bal_all_ex[, "Std. Mean Diff."],
smd_matched = bal_matched_ex[, "Std. Mean Diff."]
)
balance_long <- balance_tbl %>%
mutate(
smd_all     = abs(smd_all),
smd_matched = abs(smd_matched)
) %>%
pivot_longer(
cols      = c(smd_all, smd_matched),
names_to  = "sample",
values_to = "abs_smd"
) %>%
mutate(
sample = recode(sample,
smd_all     = "Unmatched",
smd_matched = "Matched")
)
p_love <- ggplot(balance_long,
aes(x = reorder(covariate, abs_smd),
y = abs_smd,
color = sample,
group = sample)) +
geom_point() +
geom_line() +
coord_flip() +
geom_hline(yintercept = 0.1, linetype = "dashed") +
labs(
x = "Covariate",
y = "Absolute standardized mean difference (|SMD|)",
title = paste("PSM LOVE plot – cohort g =", example_g),
color = "Sample"
) +
theme_minimal()
ggsave(
filename = file.path(
out_dir_match,
paste0("loveplot_psm_g", example_g, ".png")
),
plot   = p_love,
width  = 7,
height = 5,
dpi    = 300
)
cat("\n[LOVE PLOT] Saved loveplot_psm_g", example_g, ".png\n")
} else {
cat("\n[LOVE PLOT] No matched controls for cohort g =", example_g, "\n")
}
} else {
cat("\n[LOVE PLOT] matchit failed for cohort g =", example_g,
"even with no caliper; skipping LOVE plot.\n")
}
} else {
cat("\n[LOVE PLOT] Not enough treated/controls for cohort g =", example_g, "\n")
}
} else {
cat("\n[LOVE PLOT] No usable PSM covariates in cohort g =", example_g, "\n")
}
} else {
cat("\n[LOVE PLOT] Cohort g =", example_g, "not found in cohort_dataL.\n")
}
} else {
cat("\n[LOVE PLOT] Example cohort g =", example_g,
"not found in matching summary; skipping.\n")
}
################################################
# 7. ASCM phase – one ASCM per cohort
################################################
outcome_var <- "ln_players_avg"
use_cem_donors <- TRUE
use_psm_donors <- FALSE
n_placebos_per_cohort <- 50
ascm_fits_list <- vector("list", length(cohort_ids))
names(ascm_fits_list) <- cohort_ids
gateA_list <- vector("list", length(cohort_ids))
names(gateA_list) <- cohort_ids
gateB_list <- vector("list", length(cohort_ids))
names(gateB_list) <- cohort_ids
for (kk in seq_along(cohort_ids)) {
c_g   <- cohort_ids[kk]
c_T0c <- cohort_T0[kk]
cat("\n==============================\n")
cat("Cohort g =", c_g, "  T0_c =", as.character(c_T0c), "\n")
c_data0 <- cohort_dataL[[kk]]
if (is.null(c_data0) || nrow(c_data0) == 0L) {
cat("  -> Empty cohort data; skipping.\n")
next
}
dat <- c_data0 %>%
filter(cohort_unit | donor_ok) %>%
mutate(
D = if_else(cohort_unit & event_time >= 0L, 1L, 0L)
)
# Restrict donors via matching flags if available
if (exists("matched_flags_full")) {
c_flags <- matched_flags_full %>%
filter(g == c_g) %>%
select(steam_id, cem_donor_matched, psm_donor_matched)
dat <- dat %>%
left_join(c_flags, by = "steam_id") %>%
mutate(
cem_donor_matched = coalesce(cem_donor_matched, 0L),
psm_donor_matched = coalesce(psm_donor_matched, 0L)
) %>%
mutate(
donor_keep = case_when(
cohort_unit      ~ TRUE,
use_cem_donors   ~ (donor_ok & cem_donor_matched == 1L),
use_psm_donors   ~ (donor_ok & psm_donor_matched == 1L),
TRUE             ~ donor_ok
)
) %>%
filter(cohort_unit | donor_keep)
}
# Drop rows with missing outcome
dat <- dat %>%
filter(!is.na(.data[[outcome_var]]))
treated_units <- unique(dat$steam_id[dat$cohort_unit])
donor_units   <- unique(dat$steam_id[dat$donor_ok & !dat$cohort_unit])
n_treated <- length(treated_units)
n_donors  <- length(donor_units)
cat("  n_treated =", n_treated, " | n_donors =", n_donors, "\n")
if (n_treated == 0L || n_donors < 5L) {
cat("  -> Not enough treated or donors; skipping this cohort.\n")
next
}
pre_times  <- sort(unique(dat$event_time[dat$event_time < 0L]))
post_times <- sort(unique(dat$event_time[dat$event_time >= 0L]))
# Looser requirement than before so ASCM actually runs
if (length(pre_times) < 2L || length(post_times) < 1L) {
cat("  -> Too few distinct pre/post periods in outcome; skipping ASCM.\n")
next
}
# Gate A: simple DiD-style diagnostics
agg_by_t <- dat %>%
group_by(event_time, D) %>%
summarise(
y = mean(.data[[outcome_var]], na.rm = TRUE),
.groups = "drop"
) %>%
tidyr::pivot_wider(
names_from   = D,
values_from  = y,
names_prefix = "D",
values_fill  = NA_real_
) %>%
mutate(
ATT_simple = D1 - D0
)
pre_df  <- agg_by_t %>% filter(event_time < 0L, !is.na(ATT_simple))
post_df <- agg_by_t %>% filter(event_time >= 0L, !is.na(ATT_simple))
if (nrow(pre_df) > 0L) {
pre_rmspe <- sqrt(mean(pre_df$ATT_simple^2))
if (nrow(pre_df) >= 2L) {
pre_lm <- lm(ATT_simple ~ event_time, data = pre_df)
pre_slope   <- coef(pre_lm)[["event_time"]]
pre_t_slope <- summary(pre_lm)$coefficients["event_time", "t value"]
} else {
pre_slope   <- NA_real_
pre_t_slope <- NA_real_
}
} else {
pre_rmspe   <- NA_real_
pre_slope   <- NA_real_
pre_t_slope <- NA_real_
}
if (nrow(post_df) > 0L) {
post_att_mean <- mean(post_df$ATT_simple)
} else {
post_att_mean <- NA_real_
}
gateA_list[[kk]] <- tibble(
g             = c_g,
T0_c          = c_T0c,
n_treated     = n_treated,
n_donors      = n_donors,
pre_rmspe     = pre_rmspe,
pre_slope     = pre_slope,
pre_t_slope   = pre_t_slope,
post_att_mean = post_att_mean
)
# Gate B: placebo-in-space (simple DiD)
if (nrow(post_df) > 0L && length(donor_units) > 0L) {
donors_for_placebo <- donor_units
if (length(donors_for_placebo) > n_placebos_per_cohort) {
donors_for_placebo <- sample(donors_for_placebo, n_placebos_per_cohort)
}
placebo_stats <- numeric(length(donors_for_placebo))
for (jj in seq_along(donors_for_placebo)) {
pid <- donors_for_placebo[jj]
dat_p <- dat %>%
mutate(
D_placebo = if_else(steam_id == pid & event_time >= 0L, 1L, 0L)
)
agg_p <- dat_p %>%
group_by(event_time, D_placebo) %>%
summarise(
y = mean(.data[[outcome_var]], na.rm = TRUE),
.groups = "drop"
) %>%
pivot_wider(
names_from   = D_placebo,
values_from  = y,
names_prefix = "D",
values_fill  = NA_real_
) %>%
mutate(
ATT_p = D1 - D0
)
post_p <- agg_p %>%
filter(event_time >= 0L, !is.na(ATT_p))
if (nrow(post_p) == 0L) {
placebo_stats[jj] <- NA_real_
} else {
placebo_stats[jj] <- mean(post_p$ATT_p)
}
}
placebo_stats <- placebo_stats[!is.na(placebo_stats)]
if (length(placebo_stats) > 0L) {
pl_mean <- mean(placebo_stats)
pl_sd   <- ifelse(length(placebo_stats) > 1L, sd(placebo_stats), NA_real_)
p_rank  <- mean(abs(placebo_stats) >= abs(post_att_mean))
} else {
pl_mean <- NA_real_
pl_sd   <- NA_real_
p_rank  <- NA_real_
}
} else {
placebo_stats <- numeric(0)
pl_mean <- NA_real_
pl_sd   <- NA_real_
p_rank  <- NA_real_
}
gateB_list[[kk]] <- tibble(
g              = c_g,
T0_c           = c_T0c,
mean_post_att  = post_att_mean,
placebo_mean   = pl_mean,
placebo_sd     = pl_sd,
placebo_p_rank = p_rank,
n_placebos     = length(placebo_stats)
)
# ASCM fit with augsynth
cat("  -> Fitting ASCM for this cohort...\n")
ascm_formula <- as.formula(
paste(outcome_var, "~ D")
)
ascm_fit_try <- try(
augsynth(
formula  = ascm_formula,
unit     = steam_id,
time     = event_time,
t_int    = 0,
data     = dat,
progfunc = "Ridge",
scm      = TRUE
),
silent = TRUE
)
if (inherits(ascm_fit_try, "try-error")) {
cat("  -> augsynth failed for this cohort; skipping ASCM.\n")
next
}
ascm_fit <- ascm_fit_try
ascm_fits_list[[kk]] <- ascm_fit
saveRDS(
ascm_fit,
file = file.path(out_dir_ascm,
sprintf("ascm_fit_g%03d.rds", c_g))
)
# Outcome path plot
png(
filename = file.path(
out_dir_ascm,
sprintf("ascm_path_g%03d.png", c_g)
),
width  = 800,
height = 600
)
plot(ascm_fit)
abline(v = 0, lty = 2, col = "gray")
dev.off()
# Simple ATT path plot
p_att <- ggplot(agg_by_t, aes(x = event_time, y = ATT_simple)) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
geom_vline(xintercept = 0, linetype = "dotted", color = "gray50") +
geom_line() +
geom_point() +
labs(
title = paste0("Simple ATT path (treated – donors), cohort g = ", c_g),
x = "Event time (weeks relative to T0_c)",
y = paste0("Mean outcome diff (", outcome_var, ")")
) +
theme_minimal()
ggsave(
filename = file.path(
out_dir_ascm,
sprintf("att_simple_g%03d.png", c_g)
),
plot  = p_att,
width = 7,
height = 5,
dpi   = 300
)
cat("  -> Saved ASCM object and plots for cohort g =", c_g, "\n")
}
################################################
# 8. Gate A / Gate B summaries
################################################
gateA_summary <- bind_rows(gateA_list[!sapply(gateA_list, is.null)])
gateB_summary <- bind_rows(gateB_list[!sapply(gateB_list, is.null)])
if (nrow(gateA_summary) > 0L) {
write_csv(gateA_summary,
file.path(out_dir_ascm, "gateA_summary.csv"))
}
if (nrow(gateB_summary) > 0L) {
write_csv(gateB_summary,
file.path(out_dir_ascm, "gateB_summary.csv"))
}
if (nrow(gateA_summary) > 0L && nrow(gateB_summary) > 0L) {
gate_summary <- gateA_summary %>%
left_join(gateB_summary, by = c("g", "T0_c"))
write_csv(gate_summary,
file.path(out_dir_ascm, "gate_summary.csv"))
cat("\nSaved:\n - gateA_summary.csv\n - gateB_summary.csv\n - gate_summary.csv\n")
} else {
cat("\nNo cohorts with complete Gate A/B diagnostics; gate_summary not written.\n")
}
