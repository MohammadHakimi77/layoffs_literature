	Keywords = {Nutrition information, Conjoint analysis, Front-of-package, Consumer research, product reformulation},
	Pages = {669 - 674},
	Title = {Product reformulation in the context of nutritional warning labels: Exploration of consumer preferences towards food concepts in three food categories},
