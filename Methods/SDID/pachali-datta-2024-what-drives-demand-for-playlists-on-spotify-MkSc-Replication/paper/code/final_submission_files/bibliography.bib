	Journal = {Obesity Reviews},
	Keywords = {Chilean Law of Food Labeling and Advertising, food reformulation, front of package, INFORMAS},
	Number = {S2},
	Pages = {129-140},
	Title = {Anticipatory effects of the implementation of the Chilean Law of Food Labeling and Advertising on food and beverage product reformulation},
